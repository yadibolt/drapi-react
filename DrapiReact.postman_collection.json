			"name": "Auth",
			"item": [
				{
					"name": "Token",
					"item": [
						{
							"name": "Token",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"let jsonData;\r",
											"try {\r",
											"    jsonData = pm.response.json();\r",
											"} catch (e) {\r",
											"    pm.test('Response is valid JSON', function () {\r",
											"        pm.expect.fail('Response body is not valid JSON');\r",
											"    });\r",
											"}\r",
											"\r",
											"if (jsonData && jsonData.data && jsonData.data.token) {\r",
											"    pm.environment.set('forever_token', jsonData.data.token);\r",
											"    pm.test('Token extracted and saved to environment variable', function () {\r",
											"        pm.expect(jsonData.data.token).to.be.a('string').and.not.empty;\r",
											"    });\r",
											"} else {\r",
											"    pm.test('Token not found in response', function () {\r",
											"        pm.expect.fail('Token not found at path data.token');\r",
											"    });\r",
											"}\r",
											""
										],
										"type": "text/javascript",
										"packages": {},
										"requests": {}
									}
								}
							],
							"request": {
								"auth": {
									"type": "noauth"
								},
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{base_url}}/v1/auth/token",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"v1",
										"auth",
										"token"
									]
								}
							},
